# --- Shared template (copy to .env at repo root; never commit real secrets) ---

# Backend API origin (Streamlit calls this). Example: https://api.yourdomain.com
BACKEND_URL=

# Telegram (shared master bot)
TELEGRAM_MASTER_BOT_TOKEN=
TELEGRAM_MASTER_BOT_USERNAME=

# Supabase (frontend + backend). Prefer SUPABASE_KEY; anon/publishable still supported.
SUPABASE_URL=
SUPABASE_KEY=

# Optional fallbacks if you do not use SUPABASE_KEY
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# OpenAI / Claude (architect + runtime)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AGENT_MODEL=gpt-4.1-mini

# Vapi.ai (voice)
VAPI_API_KEY=
VAPI_BASE_URL=https://api.vapi.ai

# Legacy alias (optional): same as BACKEND_URL
# WEBHOOK_SERVER_URL=
